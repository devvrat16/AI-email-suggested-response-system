    "results = []\n",
    "\n",
    "for test in test_cases:\n",
    "\n",
    "    generated = generate_reply(test[\"email\"])\n",
    "\n",
    "    score = evaluate(test[\"reference\"], generated)\n",
    "\n",
    "    results.append({\n",
    "        \"Incoming Email\": test[\"email\"],\n",
    "        \"Generated Reply\": generated,\n",
    "        \"Semantic Similarity\": score[\"Semantic Similarity\"],\n",
    "        \"ROUGE-L\": score[\"ROUGE-L\"],\n",
    "        \"Overall Score\": score[\"Overall\"]\n",
    "    })\n",
    "\n",
    "results = pd.DataFrame(results)\n",
    "\n",
    "results"
   ]
